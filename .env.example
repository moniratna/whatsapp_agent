# Local development only. Replace the database URL with the service in compose.yaml.
APP_ENV=development
APP_RELEASE=local
RUN_WORKERS_IN_API=false
DATABASE_URL=postgresql+psycopg://assistant:assistant@localhost:5432/assistant

# Live WhatsApp transport remains disabled until a test session and license are approved.
OPENWA_BASE_URL=http://localhost:8001
OPENWA_API_KEY=replace-me
OPENWA_WEBHOOK_SECRET=replace-me
OPENWA_ENABLED=false
OPENWA_TRANSPORT_MODE=fake
OPENWA_INTERACTIVE_ENABLED=false
RESPONSE_SLA_MINUTES=30
EXPORTS_DIRECTORY=var/private_exports
EXPORT_RETENTION_HOURS=24
# Set a private, encrypted S3 bucket for staging/production; leave blank for local development.
EXPORTS_S3_BUCKET=
EXPORTS_S3_PREFIX=private/transcript-exports

# Local development may load the Bedrock API key from .env; use secret-manager injection outside local development.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=replace-me
AWS_BEARER_TOKEN_BEDROCK=replace-me
BEDROCK_ENABLED=false

# Zoho API v8 OAuth. Select the data center/accounts domain for the target organization.
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_DOMAIN=https://www.zohoapis.com
ZOHO_CLIENT_ID=replace-me
ZOHO_CLIENT_SECRET=replace-me
ZOHO_REFRESH_TOKEN=replace-me
ZOHO_ENABLED=false
# Configure module names and API field names from the target Zoho organization before enabling.
ZOHO_MODULE_MAPPING_JSON={}
ZOHO_FIELD_MAPPING_JSON={}

# Production requires an OIDC issuer and client. Local identity adapter is isolated to dev.
AUTH_MODE=development
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=

# Shared only with the server-side Next.js dashboard proxy; restricts access to /api/v1/dashboard.
DASHBOARD_API_KEY=replace-with-a-long-random-secret

# Safe default: shadow drafts are private and are never sent automatically.
AI_MODE=shadow
AI_KILL_SWITCH=true
